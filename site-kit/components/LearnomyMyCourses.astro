---
/**
 * Your courses: the signed-in member's courses with progress, the certificate of each finished course
 * (view, copy its link, turn the link off or on again with a new link), and erase of their own course data.
 * Mount it on your site's account page:
 *   import LearnomyMyCourses from "../components/LearnomyMyCourses.astro";
 *   <LearnomyMyCourses />
 */
import "../styles/learnomy.css";
import { S } from "../lib/learnomy-strings";

interface Props {
	/** Heading level, so it fits the account page around it. */
	level?: 2 | 3;
}
const { level = 2 } = Astro.props;
const Heading = `h${level}` as const;
---

<section class="learnomy learnomy-mine" aria-labelledby="learnomy-mine-heading" aria-busy="true" data-learnomy-mine>
	<Heading id="learnomy-mine-heading" data-learnomy-mine-heading>{S.mine.heading}</Heading>
	<div data-learnomy-mine-body>
		<div class="learnomy-skeleton" data-learnomy-mine-loading>
			<span class="learnomy-sr" aria-live="polite">{S.mine.loading}</span>
			<span aria-hidden="true"></span>
			<span aria-hidden="true"></span>
			<span aria-hidden="true"></span>
		</div>
	</div>
	<p class="learnomy-status" role="status" aria-live="polite" data-learnomy-mine-status></p>
</section>

<script>
	import { api, esc, signInUrl } from "../lib/wbcom-kit";
	import { certificateHref, courseHref, percent, PLUGIN } from "../lib/learnomy";
	import { S } from "../lib/learnomy-strings";

	/** One row of myCourses: progress is counted on the course's published lessons, as on the course page. */
	type Item = { course: string; slug: string; title: string; available: boolean; done: number; total: number; finished: boolean; quizzesPassed?: number };

	/** One certificate from myCertificates: the link token when the link is on. */
	type Cert = { course: string; token: string; on: boolean; issued?: boolean };
	let certs = new Map<string, Cert>();

	function certHtml(cert: Cert, title: string): string {
		const name = esc(title || S.catalog.title);
		const label = (action: string) => esc(S.certAction(action, title || S.catalog.title));
		const actions = cert.on
			? `<a class="learnomy-btn learnomy-btn--quiet" href="${esc(certificateHref(cert.token))}" aria-label="${label(S.cert.view)}" data-learnomy-cert-view>${esc(S.cert.view)}</a><button class="learnomy-btn learnomy-btn--quiet" type="button" aria-label="${label(S.cert.copy)}" data-learnomy-cert-copy>${esc(S.cert.copy)}</button><button class="learnomy-btn learnomy-btn--quiet" type="button" aria-label="${label(S.cert.turnOff)}" data-learnomy-cert-switch="off">${esc(S.cert.turnOff)}</button>`
			: cert.issued === false
				? // No link made yet (the plugin makes it on the next view, or now on request): never shown as off.
					`<button class="learnomy-btn learnomy-btn--quiet" type="button" aria-label="${label(S.cert.getLink)}" data-learnomy-cert-switch="on">${esc(S.cert.getLink)}</button>`
				: `<span class="learnomy-muted">${esc(S.cert.off)}</span><button class="learnomy-btn learnomy-btn--quiet" type="button" aria-label="${label(S.cert.turnOn)}" data-learnomy-cert-switch="on">${esc(S.cert.turnOn)}</button>`;
		return `<div class="learnomy-cert-row" role="group" aria-label="${esc(S.certAction(S.cert.label, title || S.catalog.title))}" data-learnomy-cert-row="${esc(cert.course)}" data-learnomy-cert-on="${cert.on ? "1" : ""}" data-learnomy-cert-title="${name}"><span class="learnomy-cert-row__label">${esc(S.cert.label)}</span><div class="learnomy-cert-row__actions">${actions}</div></div>`;
	}

	function rowHtml(item: Item): string {
		const title = esc(item.title || S.catalog.title);
		// A course that was deleted or unpublished: named, no link, and its data can still be erased below.
		if (!item.available) {
			const kept = certs.get(item.course);
			return `<li class="learnomy-row" data-learnomy-mine-row="${esc(item.course)}" data-learnomy-mine-gone><span class="learnomy-row__title">${title}</span><div class="learnomy-progress"><span class="learnomy-muted">${esc(S.mine.gone)}</span></div>${kept ? certHtml(kept, item.title) : ""}</li>`;
		}
		const href = courseHref(item.slug || item.course);
		const progress = item.finished
			? `<span class="learnomy-badge learnomy-badge--done">${esc(S.mine.completed)}</span>`
			: `<span>${esc(S.progress(item.done, item.total))}</span><span class="learnomy-progress__track" aria-hidden="true"><span class="learnomy-progress__fill" style="width:${percent(item.done, item.total)}%"></span></span>`;
		const action = item.finished ? S.mine.review : S.mine.continue;
		const passed = item.quizzesPassed ? `<span class="learnomy-muted" data-learnomy-mine-passed>${esc(S.quizzesPassed(item.quizzesPassed))}</span>` : "";
		const cert = certs.get(item.course);
		return `<li class="learnomy-row" data-learnomy-mine-row="${esc(item.course)}"><a class="learnomy-row__title" href="${esc(href)}">${title}</a><div class="learnomy-progress">${progress}${passed}</div><a class="learnomy-btn ${item.finished ? "learnomy-btn--quiet" : ""}" href="${esc(href)}" aria-label="${esc(`${action}: ${item.title}`)}">${esc(action)}</a>${cert ? certHtml(cert, item.title) : ""}</li>`;
	}

	function eraseHtml(): string {
		return `<div class="learnomy-erase" data-learnomy-erase><p class="learnomy-muted">${esc(S.mine.eraseHelp)}</p><div class="learnomy-actions" data-learnomy-erase-actions><button class="learnomy-btn learnomy-btn--quiet" type="button" data-learnomy-erase-start>${esc(S.mine.erase)}</button></div></div>`;
	}

	function paint(root: HTMLElement, items: Item[]) {
		const body = root.querySelector<HTMLElement>("[data-learnomy-mine-body]")!;
		// Erase is always offered to a signed-in member: quiz scores can exist without an enrollment.
		body.innerHTML = `${
			items.length
				? `<ul class="learnomy-rows" data-learnomy-mine-list>${items.map(rowHtml).join("")}</ul>`
				: `<div class="learnomy-notice" data-learnomy-mine-empty><strong>${esc(S.mine.empty)}</strong><a class="learnomy-btn" href="/courses/">${esc(S.mine.browse)}</a></div>`
		}${eraseHtml()}`;
		bindErase(root);
		bindCerts(root);
	}

	/** View, copy, and turn a certificate link off or on again (a new link), from the row's buttons. */
	function bindCerts(root: HTMLElement) {
		root.querySelectorAll<HTMLElement>("[data-learnomy-cert-row]").forEach((box) => bindCert(root, box));
	}

	function bindCert(root: HTMLElement, box: HTMLElement) {
		const status = root.querySelector<HTMLElement>("[data-learnomy-mine-status]")!;
		const say = (text: string, tone = "") => {
			status.dataset.tone = tone;
			status.textContent = text;
		};
		const course = box.dataset.learnomyCertRow!;
		const title = box.dataset.learnomyCertTitle ?? "";
		box.querySelector("[data-learnomy-cert-copy]")?.addEventListener("click", async () => {
			const cert = certs.get(course);
			if (!cert) return;
			const url = new URL(certificateHref(cert.token), location.origin).href;
			try {
				await navigator.clipboard.writeText(url);
				say(S.cert.copied);
			} catch {
				say(`${S.cert.copyFailed} ${url}`);
			}
		});
		box.querySelector<HTMLButtonElement>("[data-learnomy-cert-switch]")?.addEventListener("click", async (event) => {
			const button = event.currentTarget as HTMLButtonElement;
			const on = button.dataset.learnomyCertSwitch === "on";
			const wasIssued = certs.get(course)?.issued !== false;
			button.setAttribute("aria-busy", "true");
			const result = await api(PLUGIN, "setCertificate", { course, on });
			if (!result.ok) {
				button.removeAttribute("aria-busy");
				return say(S.cert.failed, "error");
			}
			const cert = { course, token: String(result.token ?? ""), on: Boolean(result.on), issued: result.issued !== false };
			certs.set(course, cert);
			const next = document.createElement("div");
			next.innerHTML = certHtml(cert, title);
			const fresh = next.firstElementChild as HTMLElement;
			box.replaceWith(fresh);
			bindCert(root, fresh);
			say(on ? (wasIssued ? S.cert.onDone : S.cert.ready) : S.cert.offDone);
			// Keep keyboard focus on the row's switch after it is redrawn.
			fresh.querySelector<HTMLButtonElement>("[data-learnomy-cert-switch]")?.focus();
		});
	}

	function bindErase(root: HTMLElement) {
		const actions = root.querySelector<HTMLElement>("[data-learnomy-erase-actions]");
		const status = root.querySelector<HTMLElement>("[data-learnomy-mine-status]")!;
		if (!actions) return;
		const ask = () => {
			actions.innerHTML = `<span class="learnomy-status">${esc(S.mine.eraseConfirm)}</span><button class="learnomy-btn learnomy-btn--danger" type="button" data-learnomy-erase-yes>${esc(S.mine.eraseYes)}</button><button class="learnomy-btn learnomy-btn--quiet" type="button" data-learnomy-erase-no>${esc(S.mine.eraseNo)}</button>`;
			const yes = actions.querySelector<HTMLButtonElement>("[data-learnomy-erase-yes]")!;
			yes.focus();
			actions.querySelector("[data-learnomy-erase-no]")!.addEventListener("click", () => {
				actions.innerHTML = `<button class="learnomy-btn learnomy-btn--quiet" type="button" data-learnomy-erase-start>${esc(S.mine.erase)}</button>`;
				actions.querySelector<HTMLButtonElement>("[data-learnomy-erase-start]")!.addEventListener("click", ask);
				actions.querySelector<HTMLButtonElement>("[data-learnomy-erase-start]")!.focus();
			});
			yes.addEventListener("click", async () => {
				yes.setAttribute("aria-busy", "true");
				yes.textContent = S.mine.erasing;
				root.setAttribute("aria-busy", "true");
				// A member with very many rows is erased in rounds: the route answers done: false until finished.
				let result = await api(PLUGIN, "eraseMember", {});
				for (let round = 0; round < 50 && result.ok && result.done === false; round += 1) result = await api(PLUGIN, "eraseMember", {});
				root.removeAttribute("aria-busy");
				if (!result.ok || result.done === false) {
					yes.removeAttribute("aria-busy");
					yes.textContent = S.mine.eraseYes;
					status.dataset.tone = "error";
					status.textContent = result.error?.message || S.mine.eraseFailed;
					return;
				}
				paint(root, []);
				status.dataset.tone = "";
				status.textContent = S.mine.erased;
			});
		};
		actions.querySelector<HTMLButtonElement>("[data-learnomy-erase-start]")!.addEventListener("click", ask);
	}

	async function load(root: HTMLElement) {
		const body = root.querySelector<HTMLElement>("[data-learnomy-mine-body]")!;
		const [result, mine] = await Promise.all([api(PLUGIN, "myCourses"), api(PLUGIN, "myCertificates")]);
		root.removeAttribute("aria-busy");
		certs = new Map(mine.ok ? ((mine.items as Cert[]) ?? []).map((cert) => [cert.course, cert]) : []);
		if (result.ok) {
			paint(root, (result.items as Item[]) ?? []);
			// The courses still show when only the certificates could not load.
			if (!mine.ok && mine.error?.code !== "SIGN_IN_REQUIRED") {
				const status = root.querySelector<HTMLElement>("[data-learnomy-mine-status]")!;
				status.dataset.tone = "error";
				status.textContent = S.cert.listFailed;
			}
			return;
		}
		if (result.error?.code === "SIGN_IN_REQUIRED") {
			body.innerHTML = `<div class="learnomy-notice" data-learnomy-mine-signin><strong>${esc(S.mine.signIn)}</strong><a class="learnomy-btn" href="${esc(signInUrl())}">${esc(S.common.signIn)}</a></div>`;
			return;
		}
		body.innerHTML = `<div class="learnomy-notice learnomy-notice--error" role="alert" data-learnomy-mine-failed><strong>${esc(S.mine.failed)}</strong><button class="learnomy-btn learnomy-btn--quiet" type="button" data-learnomy-mine-retry>${esc(S.common.tryAgain)}</button></div>`;
		body.querySelector("[data-learnomy-mine-retry]")!.addEventListener("click", () => {
			root.setAttribute("aria-busy", "true");
			void load(root);
		});
	}

	document.querySelectorAll<HTMLElement>("[data-learnomy-mine]").forEach((root) => void load(root));
</script>
