---
/**
 * Your courses: the signed-in member's courses with progress, and erase of their own course data.
 * Mount it on your site's account page:
 *   import LearnomyMyCourses from "../components/LearnomyMyCourses.astro";
 *   <LearnomyMyCourses />
 */
import "../styles/learnomy.css";
import { S } from "../lib/learnomy-strings";

interface Props {
	/** Heading level, so it fits the account page around it. */
	level?: 2 | 3;
}
const { level = 2 } = Astro.props;
const Heading = `h${level}` as const;
---

<section class="learnomy learnomy-mine" aria-labelledby="learnomy-mine-heading" aria-busy="true" data-learnomy-mine>
	<Heading id="learnomy-mine-heading" data-learnomy-mine-heading>{S.mine.heading}</Heading>
	<div data-learnomy-mine-body>
		<div class="learnomy-skeleton" data-learnomy-mine-loading>
			<span class="learnomy-sr" aria-live="polite">{S.mine.loading}</span>
			<span aria-hidden="true"></span>
			<span aria-hidden="true"></span>
			<span aria-hidden="true"></span>
		</div>
	</div>
	<p class="learnomy-status" role="status" aria-live="polite" data-learnomy-mine-status></p>
</section>

<script>
	import { api, esc, signInUrl } from "../lib/wbcom-kit";
	import { courseHref, percent, PLUGIN } from "../lib/learnomy";
	import { S } from "../lib/learnomy-strings";

	type Item = { course: string; slug: string; title: string; done: number; total: number; completedAt: string | null };

	function rowHtml(item: Item): string {
		const pct = percent(item.done, item.total);
		const href = courseHref(item.slug || item.course);
		const progress = item.completedAt
			? `<span class="learnomy-badge learnomy-badge--done">${esc(S.mine.completed)}</span>`
			: `<span>${esc(S.progress(Math.min(item.done, item.total), item.total))}</span><span class="learnomy-progress__track" aria-hidden="true"><span class="learnomy-progress__fill" style="width:${pct}%"></span></span>`;
		return `<li class="learnomy-row" data-learnomy-mine-row="${esc(item.course)}"><a class="learnomy-row__title" href="${esc(href)}">${esc(item.title || S.catalog.title)}</a><div class="learnomy-progress">${progress}</div><a class="learnomy-btn ${item.completedAt ? "learnomy-btn--quiet" : ""}" href="${esc(href)}" aria-label="${esc(`${item.completedAt ? S.mine.review : S.mine.continue}: ${item.title}`)}">${esc(item.completedAt ? S.mine.review : S.mine.continue)}</a></li>`;
	}

	function eraseHtml(): string {
		return `<div class="learnomy-erase" data-learnomy-erase><p class="learnomy-muted">${esc(S.mine.eraseHelp)}</p><div class="learnomy-actions" data-learnomy-erase-actions><button class="learnomy-btn learnomy-btn--quiet" type="button" data-learnomy-erase-start>${esc(S.mine.erase)}</button></div></div>`;
	}

	function paint(root: HTMLElement, items: Item[]) {
		const body = root.querySelector<HTMLElement>("[data-learnomy-mine-body]")!;
		body.innerHTML = items.length
			? `<ul class="learnomy-rows" data-learnomy-mine-list>${items.map(rowHtml).join("")}</ul>${eraseHtml()}`
			: `<div class="learnomy-notice" data-learnomy-mine-empty><strong>${esc(S.mine.empty)}</strong><a class="learnomy-btn" href="/courses/">${esc(S.mine.browse)}</a></div>`;
		bindErase(root);
	}

	function bindErase(root: HTMLElement) {
		const actions = root.querySelector<HTMLElement>("[data-learnomy-erase-actions]");
		const status = root.querySelector<HTMLElement>("[data-learnomy-mine-status]")!;
		if (!actions) return;
		const ask = () => {
			actions.innerHTML = `<span class="learnomy-status">${esc(S.mine.eraseConfirm)}</span><button class="learnomy-btn learnomy-btn--danger" type="button" data-learnomy-erase-yes>${esc(S.mine.eraseYes)}</button><button class="learnomy-btn learnomy-btn--quiet" type="button" data-learnomy-erase-no>${esc(S.mine.eraseNo)}</button>`;
			const yes = actions.querySelector<HTMLButtonElement>("[data-learnomy-erase-yes]")!;
			yes.focus();
			actions.querySelector("[data-learnomy-erase-no]")!.addEventListener("click", () => {
				actions.innerHTML = `<button class="learnomy-btn learnomy-btn--quiet" type="button" data-learnomy-erase-start>${esc(S.mine.erase)}</button>`;
				actions.querySelector<HTMLButtonElement>("[data-learnomy-erase-start]")!.addEventListener("click", ask);
				actions.querySelector<HTMLButtonElement>("[data-learnomy-erase-start]")!.focus();
			});
			yes.addEventListener("click", async () => {
				yes.setAttribute("aria-busy", "true");
				yes.textContent = S.mine.erasing;
				root.setAttribute("aria-busy", "true");
				// A member with very many rows is erased in rounds: the route answers done: false until finished.
				let result = await api(PLUGIN, "eraseMember", {});
				for (let round = 0; round < 50 && result.ok && result.done === false; round += 1) result = await api(PLUGIN, "eraseMember", {});
				root.removeAttribute("aria-busy");
				if (!result.ok || result.done === false) {
					yes.removeAttribute("aria-busy");
					yes.textContent = S.mine.eraseYes;
					status.dataset.tone = "error";
					status.textContent = result.error?.message || S.mine.eraseFailed;
					return;
				}
				paint(root, []);
				status.dataset.tone = "";
				status.textContent = S.mine.erased;
			});
		};
		actions.querySelector<HTMLButtonElement>("[data-learnomy-erase-start]")!.addEventListener("click", ask);
	}

	async function load(root: HTMLElement) {
		const body = root.querySelector<HTMLElement>("[data-learnomy-mine-body]")!;
		const result = await api(PLUGIN, "myCourses");
		root.removeAttribute("aria-busy");
		if (result.ok) return paint(root, (result.items as Item[]) ?? []);
		if (result.error?.code === "SIGN_IN_REQUIRED") {
			body.innerHTML = `<div class="learnomy-notice" data-learnomy-mine-signin><strong>${esc(S.mine.signIn)}</strong><a class="learnomy-btn" href="${esc(signInUrl())}">${esc(S.common.signIn)}</a></div>`;
			return;
		}
		body.innerHTML = `<div class="learnomy-notice learnomy-notice--error" role="alert" data-learnomy-mine-failed><strong>${esc(S.mine.failed)}</strong><button class="learnomy-btn learnomy-btn--quiet" type="button" data-learnomy-mine-retry>${esc(S.common.tryAgain)}</button></div>`;
		body.querySelector("[data-learnomy-mine-retry]")!.addEventListener("click", () => {
			root.setAttribute("aria-busy", "true");
			void load(root);
		});
	}

	document.querySelectorAll<HTMLElement>("[data-learnomy-mine]").forEach((root) => void load(root));
</script>
